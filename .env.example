# ==============================================================================
# EMBER — Application Environment Configuration
# ==============================================================================

# Supabase Public Configuration (Safe for Mobile Client / Expo)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Razorpay Configuration
# Public key is used by client checkout
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
# Private secret is strictly for server-side functions / webhooks (NEVER prefix with EXPO_PUBLIC)
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# Supabase Server-Side Secret Key (Used in Edge Functions and Migrations ONLY)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Restaurant Default Configuration
EXPO_PUBLIC_DEFAULT_RESTAURANT_ID=ember-main-001
EXPO_PUBLIC_DEFAULT_BRANCH_ID=ember-branch-rajkot-01
EXPO_PUBLIC_ENABLE_MOCK_FALLBACK=true

